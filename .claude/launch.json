{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "precicv-dev",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "export PATH=\"$HOME/.local/node/bin:$PATH\" && npm run dev"],
      "port": 3000
    },
    {
      "name": "precicv-main",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "export PATH=\"$HOME/.local/node/bin:$PATH\" && npm run dev -- --port 3100"],
      "port": 3100
    }
  ]
}
